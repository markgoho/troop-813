{
  "hosting": [
    {
      "target": "hq",
      "public": "apps/hq/build",
      "ignore": ["**/.*"],
      "rewrites": [
        {
          "source": "/api/**",
          "run": { "serviceId": "api", "region": "us-east1" }
        },
        { "source": "/_app/**", "destination": "/_app/missing" },
        { "source": "**", "destination": "/200.html" }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/_app/immutable/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "singleProjectMode": false,
    "firestore": { "host": "127.0.0.1", "port": 21000, "websocketPort": 21001 },
    "auth": { "host": "127.0.0.1", "port": 21002 },
    "hub": { "host": "127.0.0.1", "port": 21003 },
    "logging": { "host": "127.0.0.1", "port": 21004 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 21005 }
  }
}
