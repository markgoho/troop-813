rules_version = '2';

// Deny-all baseline. Go (Admin SDK) is the only writer and bypasses rules.
// Each match below opens only a read the Kiosk or Leader screens need (ADR 0001).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // A signed-in person can read their own users doc (role etc.), nobody else's.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // A Leader (Admin included), by the role Go stored in users/{uid}.
    function isLeader() {
      let user = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null
        && exists(user)
        && get(user).data.role in ['leader', 'admin'];
    }

    // The Roster tab lists scouts live (onSnapshot = list) and opens Scouts (get).
    match /scouts/{scoutId} {
      allow read: if isLeader();
    }
  }
}
