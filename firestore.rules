rules_version = '2';

// Deny-all baseline. Go (Admin SDK) is the only writer and bypasses rules.
// Each match below opens only a read the Kiosk or Leader screens need (ADR 0001).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // A signed-in person can read their own users doc (role etc.), nobody else's.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }

    // A Leader (Admin included), by the role Go stored in users/{uid}.
    function isLeader() {
      let user = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null
        && exists(user)
        && get(user).data.role in ['leader', 'admin'];
    }

    // The Meeting Kiosk: signed in with the custom token Go minted at Start
    // (claims role, kioskSessionId, meetingId) and its session not replaced
    // by a newer unlock. Go enforces 22:00 and the idle lock on writes; reads
    // stay open while asleep so a phone's Wake reaches the tablet via onSnapshot.
    function isKiosk() {
      let token = request.auth.token;
      let session = /databases/$(database)/documents/kioskSessions/$(token.get('kioskSessionId', '-'));
      return request.auth != null
        && token.get('role', '') == 'kiosk'
        && exists(session)
        && get(session).data.replaced == false
        && get(session).data.meetingId == token.get('meetingId', '');
    }

    // The Kiosk's live state: its own Meeting doc only. A Leader's Tonight
    // tab gets any Meeting doc and its attendance (never the Kiosk).
    match /meetings/{meetingId} {
      allow get: if (isKiosk() && request.auth.token.meetingId == meetingId) || isLeader();
      // The Meetings tab lists every Meeting (Leaders only, never the Kiosk).
      allow list: if isLeader();
      match /attendance/{attendanceId} {
        allow read: if isLeader();
      }
    }

    // Kiosk status: the tablet watches its own session (lastActivityAt) to
    // sleep and wake, a Leader's Tonight tab watches any. Reads only; Go
    // writes lastActivityAt (every Kiosk write, and Wake).
    match /kioskSessions/{sessionId} {
      allow get: if isKiosk() && request.auth.token.kioskSessionId == sessionId;
      allow read: if isLeader();
    }

    // The Roster tab lists scouts live (onSnapshot = list) and opens Scouts
    // (get); the Kiosk lists them for its name list.
    match /scouts/{scoutId} {
      allow read: if isLeader() || isKiosk();
    }

    // The Events tab and Event page list Events and every RSVP live.
    match /events/{eventId} {
      allow read: if isLeader();
    }
    match /rsvps/{rsvpId} {
      allow read: if isLeader();
    }
  }
}
